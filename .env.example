APP_NAME=enterprise-agentic-intelligence-platform
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Provider-neutral LLM configuration.
LLM_PROVIDER=mock
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# API security.
# Keep disabled for local development unless an API key is configured.
API_AUTH_ENABLED=false
API_AUTH_KEY=

# Process-local fixed-window rate limiting.
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60
